*.pdf
*.xlsx
*.xls
*.dwg
*.dxf
*.nwd
*.msg

# Logs
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
